# ============================================================
#  Multimodal RAG Tourism — Environment Variables
#  Copy this file to .env and fill in your own values.
#  Never commit .env to version control.
# ============================================================

# --- Google Gemini API ---
# Used for intent extraction (intent.py) and RAG response generation (hybrid.py)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Qdrant Vector Database ---
# Used for semantic (semantic.py) and visual (visual.py) retrieval, and ingestion (load_vectors.py)
# For a local instance use: http://localhost:6333
# For Qdrant Cloud, get your URL and key at: https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here

# --- PostgreSQL / Supabase Database ---
# Used for structured relational queries (structured.py) and data ingestion (load_sql.py)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Supabase Image Storage ---
# Public CDN base URL for attraction images stored in Supabase Storage
# Used by image_helpers.py to build image URLs (e.g. <base_url>/M001_1.jpg)
# Format: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>/
SUPABASE_IMAGE_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/your-bucket/
